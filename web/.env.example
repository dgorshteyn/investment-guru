# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 1 auth allowlist (comma-separated emails) ---
# Only addresses listed here can sign in. In Phase 2 this is replaced by
# invite codes. Example: EMAIL_ALLOWLIST=dennisgorshteyn@gmail.com,friend@example.com
EMAIL_ALLOWLIST=

# --- Python worker (Fly.io URL once deployed) ---
WORKER_URL=http://localhost:8080
WORKER_SHARED_SECRET=

# --- Market data ---
TIINGO_API_KEY=
